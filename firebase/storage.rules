rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function imageUpload() {
      return request.resource != null && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    function item(id) { return firestore.get(/databases/(default)/documents/items/$(id)).data; }
    function profile() { return firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data; }
    match /items/{filename} {
      // Initial upload precedes the item document. Put each owner's photos in their own folder.
      allow read, write: if false;
    }
    match /items/{uid}/{filename} {
      allow write: if signedIn() && uid == request.auth.uid && imageUpload();
      allow read: if signedIn() && item(filename.split('[.]')[0]).campusKey == profile().campusKey;
    }
    match /threads/{threadId}/{uid}/{filename} {
      function thread() { return firestore.get(/databases/(default)/documents/threads/$(threadId)).data; }
      allow read: if signedIn() && request.auth.uid in thread().participantUids;
      allow write: if signedIn() && request.auth.uid == uid && request.auth.uid in thread().participantUids && imageUpload();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
